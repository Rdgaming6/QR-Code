# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://my-app.run.app)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for constructing the permanent QR redirect URLs (https://YOUR_DOMAIN.com/r/:code).
APP_URL="http://localhost:3000"

# Application Port (defaults to 3000)
PORT="3000"

# JWT secret key for signing session tokens
JWT_SECRET="fluxqr-production-secret-change-in-production-2026"

# Optional: Supabase configuration (if connecting directly to remote Supabase PostgreSQL)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOi..."
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

